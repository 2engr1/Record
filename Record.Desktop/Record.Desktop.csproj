<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\assets\ui\forest-cat.png"
              Link="Assets\UI\forest-cat.png" />

    <Resource Include="..\assets\ui\forest-cat-states.png"
              Link="Assets\UI\forest-cat-states.png" />

    <Resource Include="..\assets\ui\decorations-sheet.png"
              Link="Assets\UI\decorations-sheet.png" />

    <Resource Include="..\assets\ui\category-icons-sheet.png"
              Link="Assets\UI\category-icons-sheet.png" />

    <Resource Include="..\assets\ui\paper-texture.png"
              Link="Assets\UI\paper-texture.png" />

    <Resource Include="..\assets\ui\forest-cat-avatar.png"
              Link="Assets\UI\forest-cat-avatar.png" />

    <Resource Include="..\assets\ui\forest-cat-home.png"
              Link="Assets\UI\forest-cat-home.png" />
  </ItemGroup>

</Project>
