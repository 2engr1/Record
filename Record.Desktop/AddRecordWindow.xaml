<Window x:Class="Record.Desktop.AddRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记一笔"
        Width="500"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PaperBrush" Color="#FFF8EE"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFDF8"/>
        <SolidColorBrush x:Key="InkBrush" Color="#493A35"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#907B70"/>
        <SolidColorBrush x:Key="CoralBrush" Color="#E7775E"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E4CEB0"/>

        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="22"
                          ShadowDepth="5"
                          Opacity="0.22"
                          Color="#4A3028"/>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PaperComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF0E8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8E2D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaperComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PaperComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFF8EE"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFF0E8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <TextBlock Text="⌄"
                                               Margin="0,0,6,2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="16"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="DropDownPopup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   VerticalOffset="5"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="190"
                                        Background="{StaticResource PaperBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="5"
                                        Effect="{StaticResource WindowShadow}">
                                    <ScrollViewer MaxHeight="220"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#F4E7D4"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="{StaticResource PaperBrush}"
                BorderBrush="#C8AA86"
                BorderThickness="1"
                CornerRadius="24"
                Padding="28"
                Effect="{StaticResource WindowShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="105"/>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="132"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="记一笔"
                               Foreground="{StaticResource InkBrush}"
                               FontFamily="Georgia"
                               FontSize="25"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="×"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="22"
                            Click="CloseButton_Click"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="18"
                        Background="#FFF0E8"
                        BorderBrush="#EDB09C"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="金额"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="¥"
                                       Foreground="{StaticResource CoralBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="AmountTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     FontSize="26"
                                     FontWeight="Bold"
                                     ToolTip="请输入金额"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="日期"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,7">
                            <TextBox x:Name="DateTextBox"
                                     Style="{StaticResource InputTextBoxStyle}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="类别"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6,2">
                            <ComboBox x:Name="CategoryComboBox"
                                      SelectedIndex="0"
                                      Style="{StaticResource PaperComboBoxStyle}">
                                <ComboBoxItem Content="餐饮"/>
                                <ComboBoxItem Content="交通"/>
                                <ComboBoxItem Content="购物"/>
                                <ComboBoxItem Content="居住"/>
                                <ComboBoxItem Content="娱乐"/>
                                <ComboBoxItem Content="医疗"/>
                                <ComboBoxItem Content="教育"/>
                                <ComboBoxItem Content="其他"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock Text="支付方式"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="6,2">
                        <ComboBox x:Name="PaymentComboBox"
                                  SelectedIndex="0"
                                  Style="{StaticResource PaperComboBoxStyle}">
                            <ComboBoxItem Content="微信支付"/>
                            <ComboBoxItem Content="支付宝"/>
                            <ComboBoxItem Content="银行卡"/>
                            <ComboBoxItem Content="现金"/>
                            <ComboBoxItem Content="其他"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock Text="备注"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,7">
                        <TextBox x:Name="NoteTextBox"
                                 Height="68"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="类型"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <RadioButton x:Name="ExpenseRadioButton"
                                 Content="支出"
                                 IsChecked="True"
                                 Foreground="{StaticResource InkBrush}"
                                 Margin="0,0,20,0"/>
                    <RadioButton x:Name="IncomeRadioButton"
                                 Content="收入"
                                 Foreground="{StaticResource InkBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                    <Button Content="取消"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button Content="保存"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
