<Window x:Class="Record.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#EEDDCB"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <!-- 导航图标 -->
        <Geometry x:Key="HomeIcon">
            M12,3 L21,10 V21 H15 V15 H9 V21 H3 V10 Z
        </Geometry>

        <Geometry x:Key="RecordIcon">
            M5,3 H19 V21 H5 Z
            M8,8 H16
            M8,12 H16
            M8,16 H14
        </Geometry>

        <Geometry x:Key="ImportIcon">
            M12,4 V16
            M7,11 L12,16 L17,11
            M5,19 H19 V22 H5 Z
        </Geometry>

        <Geometry x:Key="AnalyticsIcon">
            M4,20 V13 H8 V20 Z
            M10,20 V8 H14 V20 Z
            M16,20 V4 H20 V20 Z
        </Geometry>

        <!-- 全局颜色 -->
        <SolidColorBrush x:Key="PageBrush" Color="#EEDDCB"/>
        <SolidColorBrush x:Key="PaperBrush" Color="#FFF8EE"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFDF8"/>
        <SolidColorBrush x:Key="PlumBrush" Color="#2E2431"/>
        <SolidColorBrush x:Key="InkBrush" Color="#493A35"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#907B70"/>
        <SolidColorBrush x:Key="CoralBrush" Color="#E7775E"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#789B77"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#E4AD4F"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E4CEB0"/>

        <!-- 左侧导航按钮 -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF8EE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Width="56"
                                Height="56"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#5A4355"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#765267"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 当前选中的导航按钮 -->
        <Style x:Key="ActiveNavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
        </Style>

        <!-- 右上角主要按钮 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
            <Setter Property="Padding" Value="17,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBackground"
                                        Property="Background"
                                        Value="#C95E49"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="16"
                          ShadowDepth="3"
                          Opacity="0.14"
                          Color="#6A4A3E"/>

    </Window.Resources>

    <Grid Margin="18">

        <!-- 应用外框 -->
        <Border Background="{StaticResource PaperBrush}"
                CornerRadius="24"
                BorderBrush="#C8AA86"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}">

            <Grid>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- 页面纸张纹理 -->
                <Image Source="/Record.Desktop;component/Assets/UI/paper-texture.png"
                    Stretch="UniformToFill"
                    Opacity="0.16"
                    IsHitTestVisible="False"/>

                <!-- 左侧深色图标导航栏 -->
                <Border Grid.Column="0"
                        Background="{StaticResource PlumBrush}"
                        CornerRadius="24,0,0,24">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="104"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="78"/>
                        </Grid.RowDefinitions>

                        <!-- Logo 占位 -->
                        <Border Grid.Row="0"
                                Width="52"
                                Height="52"
                                CornerRadius="18"
                                Background="#514052"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Image Source="/Record.Desktop;component/Assets/UI/forest-cat.png"
                                Width="45"
                                Height="45"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <!-- 四个必要页面 -->
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">

                            <Button Style="{StaticResource ActiveNavButtonStyle}"
                                    ToolTip="首页"
                                    AutomationProperties.Name="首页">
                                <Path Data="{StaticResource HomeIcon}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                     Path=Foreground}"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    ToolTip="记账"
                                    AutomationProperties.Name="记账">
                                <Path Data="{StaticResource RecordIcon}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                      Path=Foreground}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    ToolTip="导入"
                                    AutomationProperties.Name="导入">
                                <Path Data="{StaticResource ImportIcon}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                      Path=Foreground}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource NavButtonStyle}"
                                    ToolTip="分析"
                                    AutomationProperties.Name="分析">
                                <Path Data="{StaticResource AnalyticsIcon}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                      Path=Foreground}"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                        </StackPanel>

                        <!-- 底部装饰 -->
                        <TextBlock Grid.Row="2"
                                   Text="✦"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- 右侧主内容区域 -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid Margin="34,28,34,34">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 页面标题 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="首页"
                                           Foreground="{StaticResource InkBrush}"
                                           FontFamily="Georgia"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                                <TextBlock Text="把日子里的每一笔，都好好记下来"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="＋ 记一笔"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 四个统计卡片 -->
                        <Grid Grid.Row="1"
                              Margin="0,28,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 总支出 -->
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,10,10"
                                    Padding="20"
                                    Background="#FFF0E8"
                                    BorderBrush="#EDB09C"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Effect="{StaticResource CardShadow}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="总支出"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"/>

                                        <TextBlock Text="¥ 12,345.67"
                                                   Margin="0,9,0,0"
                                                   Foreground="{StaticResource CoralBrush}"
                                                   FontSize="25"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="全部已记录支出"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="￥"
                                               Foreground="{StaticResource CoralBrush}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 总收入 -->
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,10"
                                    Padding="20"
                                    Background="#F1F4E9"
                                    BorderBrush="#B8C78D"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Effect="{StaticResource CardShadow}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="总收入"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"/>

                                        <TextBlock Text="¥ 18,765.43"
                                                   Margin="0,9,0,0"
                                                   Foreground="{StaticResource GreenBrush}"
                                                   FontSize="25"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="全部已记录收入"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="＋"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 本月支出 -->
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,10,10,0"
                                    Padding="20"
                                    Background="#FFF8EE"
                                    BorderBrush="#E4CEB0"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="本月支出"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"/>

                                        <TextBlock Text="¥ 2,345.67"
                                                   Margin="0,8,0,0"
                                                   Foreground="{StaticResource CoralBrush}"
                                                   FontSize="21"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="2026 年 8 月"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="▂▅▇"
                                               Foreground="{StaticResource CoralBrush}"
                                               FontSize="22"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 本月收入 -->
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="10,10,0,0"
                                    Padding="20"
                                    Background="#FFF8EE"
                                    BorderBrush="#E4CEB0"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="本月收入"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"/>

                                        <TextBlock Text="¥ 4,321.00"
                                                   Margin="0,8,0,0"
                                                   Foreground="{StaticResource GreenBrush}"
                                                   FontSize="21"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="2026 年 8 月"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="▂▅▇"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontSize="22"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </Grid>

                        <!-- 最近记录标题 -->
                        <Grid Grid.Row="2"
                              Margin="0,30,0,12">

                            <TextBlock Text="最近记录"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="查看全部  ›"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource CoralBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 最近记录列表 -->
                        <Border Grid.Row="3"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="18">

                            <StackPanel>

                                <!-- 表头 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="说明"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>

                                    <TextBlock Grid.Column="1"
                                               Text="类别"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>

                                    <TextBlock Grid.Column="2"
                                               Text="日期"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>

                                    <TextBlock Grid.Column="3"
                                               Text="金额"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>
                                </Grid>

                                <Rectangle Height="1"
                                           Fill="{StaticResource LineBrush}"/>

                                <!-- 记录 1 -->
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="午餐 · 拉面"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="14"/>

                                    <TextBlock Grid.Column="1"
                                               Text="餐饮"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="2"
                                               Text="今天"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="3"
                                               Text="- ¥ 28.00"
                                               Foreground="{StaticResource CoralBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <!-- 记录 2 -->
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="地铁通勤"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="14"/>

                                    <TextBlock Grid.Column="1"
                                               Text="交通"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="2"
                                               Text="昨天"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="3"
                                               Text="- ¥ 6.00"
                                               Foreground="{StaticResource CoralBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <!-- 记录 3 -->
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="八月工资"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="14"/>

                                    <TextBlock Grid.Column="1"
                                               Text="工资"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="2"
                                               Text="08-01"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="3"
                                               Text="+ ¥ 18,000.00"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Window>