                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,10,0"
                                    Padding="18"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <Grid>
                                    <TextBlock Text="收支趋势"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <Viewbox Grid.Row="1"
                                             Margin="0,12,0,0"
                                             Stretch="Fill">
                                        <Canvas Width="500" Height="150">
                                            <Line X1="28" Y1="126" X2="480" Y2="126" Stroke="#E4CEB0" StrokeThickness="1"/>
                                            <Line X1="28" Y1="28" X2="28" Y2="126" Stroke="#E4CEB0" StrokeThickness="1"/>
                                            <Line X1="28" Y1="77" X2="480" Y2="77" Stroke="#F0E3D2" StrokeThickness="1" StrokeDashArray="3,4"/>
                                            <Polyline x:Name="AnalyticsExpenseLine"
                                                      Points="28,106 100,88 172,96 244,72 316,84 388,60 480,69"
                                                      Stroke="{StaticResource CoralBrush}"
                                                      StrokeThickness="3"
                                                      Fill="Transparent"/>
                                            <Polyline x:Name="AnalyticsIncomeLine"
                                                      Points="28,92 100,59 172,70 244,42 316,53 388,32 480,46"
                                                      Stroke="{StaticResource GreenBrush}"
                                                      StrokeThickness="3"
                                                      Fill="Transparent"/>
                                            <Ellipse x:Name="AnalyticsExpenseEndPoint" Canvas.Left="474" Canvas.Top="63" Width="10" Height="10" Fill="{StaticResource CoralBrush}"/>
                                            <Ellipse x:Name="AnalyticsIncomeEndPoint" Canvas.Left="474" Canvas.Top="40" Width="10" Height="10" Fill="{StaticResource GreenBrush}"/>
                                            <TextBlock x:Name="AnalyticsStartDateTextBlock" Canvas.Left="32" Canvas.Top="130" Text="08-01" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                            <TextBlock x:Name="AnalyticsMiddleDateTextBlock" Canvas.Left="238" Canvas.Top="130" Text="08-15" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                            <TextBlock x:Name="AnalyticsEndDateTextBlock" Canvas.Left="442" Canvas.Top="130" Text="08-31" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource CoralBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="支出" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,12,0"/>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="收入" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="18"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <Grid>
                                    <TextBlock Text="支出类别"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <StackPanel Margin="0,38,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AnalyticsCategory1TextBlock" Text="餐饮" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            <Border Grid.Column="1" Height="8" Background="#F5E8D8" CornerRadius="4" VerticalAlignment="Center"><Border x:Name="AnalyticsCategory1Bar" Width="112" HorizontalAlignment="Left" Background="{StaticResource CoralBrush}" CornerRadius="4"/></Border>
                                            <TextBlock x:Name="AnalyticsCategory1PercentTextBlock" Grid.Column="2" Text="52%" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AnalyticsCategory2TextBlock" Text="交通" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            <Border Grid.Column="1" Height="8" Background="#F5E8D8" CornerRadius="4" VerticalAlignment="Center"><Border x:Name="AnalyticsCategory2Bar" Width="74" HorizontalAlignment="Left" Background="{StaticResource GoldBrush}" CornerRadius="4"/></Border>
                                            <TextBlock x:Name="AnalyticsCategory2PercentTextBlock" Grid.Column="2" Text="24%" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AnalyticsCategory3TextBlock" Text="购物" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            <Border Grid.Column="1" Height="8" Background="#F5E8D8" CornerRadius="4" VerticalAlignment="Center"><Border x:Name="AnalyticsCategory3Bar" Width="54" HorizontalAlignment="Left" Background="#B8C78D" CornerRadius="4"/></Border>
                                            <TextBlock x:Name="AnalyticsCategory3PercentTextBlock" Grid.Column="2" Text="16%" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AnalyticsCategory4TextBlock" Text="其他" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            <Border Grid.Column="1" Height="8" Background="#F5E8D8" CornerRadius="4" VerticalAlignment="Center"><Border x:Name="AnalyticsCategory4Bar" Width="28" HorizontalAlignment="Left" Background="#A8B4B2" CornerRadius="4"/></Border>
                                            <TextBlock x:Name="AnalyticsCategory4PercentTextBlock" Grid.Column="2" Text="8%" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="4"
                                Margin="0,20,0,0"
                                Padding="16"
                                Background="#F6F0E4"
                                BorderBrush="#D7BE9C"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="本期收支概览"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AnalyticsOverviewTextBlock"
                                               Text="支出 ¥ 0.00 · 收入 ¥ 0.00"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Height="9"
                                        Margin="24,0"
                                        Background="#E9DEC9"
                                        CornerRadius="5"
                                        VerticalAlignment="Center">
                                    <Border x:Name="AnalyticsOverviewBar"
                                            Width="0"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource CoralBrush}"
                                            CornerRadius="5"/>
                                </Border>
                                <TextBlock x:Name="AnalyticsOverviewPercentTextBlock"
                                           Grid.Column="2"
                                           Text="暂无数据"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 记账明细页 -->
                <Grid x:Name="RecordsPage"
                      Visibility="Collapsed"
                      ClipToBounds="True">
                    <Grid Margin="34,28,34,34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="记账"
                                           Foreground="{StaticResource InkBrush}"
                                           FontFamily="Georgia"
                                           FontSize="30"
                                           FontWeight="Bold"/>
                                <TextBlock Text="每一笔记录，都让生活更有把握"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="＋ 记一笔"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="AddRecordButton_Click"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,28,0,0"
                                Padding="18"
                                Background="#FFF3E8"
                                BorderBrush="#EDB09C"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="记录数量"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>
                                    <TextBlock x:Name="RecordsCountTextBlock"
                                               Text="0 笔"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="支出合计"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>
                                    <TextBlock x:Name="RecordsExpenseTextBlock"
                                               Text="¥ 0.00"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource CoralBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="收入合计"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"/>
                                    <TextBlock x:Name="RecordsIncomeTextBlock"
                                               Text="¥ 0.00"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,22,0,0"
                                Padding="10,8"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="快速筛选"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,8,0"/>
                                        <Button x:Name="AllRecordsFilterButton"
                                                Content="全部"
                                                Style="{StaticResource ActiveFilterChipStyle}"
                                                Click="AllRecordsFilterButton_Click"/>
                                        <Button x:Name="CurrentMonthFilterButton"
                                                Content="本月"
                                                Style="{StaticResource FilterChipStyle}"
                                                Click="CurrentMonthFilterButton_Click"/>
                                        <Button x:Name="ExpenseFilterButton"
                                                Content="支出"
                                                Style="{StaticResource FilterChipStyle}"
                                                Click="ExpenseFilterButton_Click"/>
                                        <Button x:Name="IncomeFilterButton"
                                                Content="收入"
                                                Style="{StaticResource FilterChipStyle}"
                                                Click="IncomeFilterButton_Click"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1"
                                          Width="220"
                                          Height="32">
                                        <TextBox x:Name="RecordSearchTextBox"
                                                 Style="{StaticResource RecordSearchTextBoxStyle}"
                                                 TextChanged="RecordSearchTextBox_TextChanged"/>
                                        <TextBlock Text="⌕"
                                                   Margin="11,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                        <TextBlock x:Name="RecordSearchPlaceholderTextBlock"
                                                   Text="搜索说明或支付方式"
                                                   Margin="32,0,8,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="类别"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,8,0"/>
                                    <Button x:Name="CategoryAllFilterButton"
                                            Content="全部类别"
                                            Tag="全部类别"
                                            Style="{StaticResource ActiveFilterChipStyle}"
                                            Click="CategoryFilterButton_Click"/>
                                    <Button x:Name="CategoryFoodFilterButton"
                                            Content="餐饮"
                                            Tag="餐饮"
                                            Style="{StaticResource FilterChipStyle}"
                                            Click="CategoryFilterButton_Click"/>
                                    <Button x:Name="CategoryTransportFilterButton"
                                            Content="交通"
                                            Tag="交通"
                                            Style="{StaticResource FilterChipStyle}"
                                            Click="CategoryFilterButton_Click"/>
                                    <Button x:Name="CategoryShoppingFilterButton"
                                            Content="购物"
                                            Tag="购物"
                                            Style="{StaticResource FilterChipStyle}"
                                            Click="CategoryFilterButton_Click"/>
                                    <Button x:Name="CategorySalaryFilterButton"
                                            Content="工资"
                                            Tag="工资"
                                            Style="{StaticResource FilterChipStyle}"
                                            Click="CategoryFilterButton_Click"/>
                                    <Button x:Name="CategoryOtherFilterButton"
                                            Content="其他"
                                            Tag="其他"
                                            Style="{StaticResource FilterChipStyle}"
                                            Click="CategoryFilterButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,24,0,12">
                            <TextBlock Text="记录明细"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="按时间排列"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Border Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18"
                                    Height="360"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 固定列定义的表头 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.3*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="说明"
                                                   Style="{StaticResource RecordsTableHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="类别"
                                                   Style="{StaticResource RecordsTableHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="支付方式"
                                                   Style="{StaticResource RecordsTableHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="日期"
                                                   Style="{StaticResource RecordsTableHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="金额"
                                                   Style="{StaticResource RecordsTableHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="5"
                                                   Text=""
                                                   Style="{StaticResource RecordsTableHeaderTextStyle}"/>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding RecordsView}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,13,0,11">
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2.3*"/>
                                                                    <ColumnDefinition Width="1.2*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                    <ColumnDefinition Width="1.3*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Description}"
                                                                       Foreground="{StaticResource InkBrush}"
                                                                       FontSize="14"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Category}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="13"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding PaymentMethod}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="13"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DisplayDate}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="13"/>
                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding DisplayAmount}"
                                                                       Foreground="{Binding AmountBrush}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"/>
                                                            <StackPanel Grid.Column="5"
                                                                        Orientation="Horizontal"
                                                                        Margin="8,0,0,0">
                                                                <Button Tag="{Binding}"
                                                                        Content="✎"
                                                                        ToolTip="编辑记录"
                                                                        Style="{StaticResource RowActionButtonStyle}"
                                                                        Click="EditRecordButton_Click"/>
                                                                <Button Tag="{Binding}"
                                                                        Content="×"
                                                                        ToolTip="删除记录"
                                                                        Style="{StaticResource RowActionButtonStyle}"
                                                                        Click="DeleteRecordButton_Click"
                                                                        Margin="5,0,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="RecordsEmptyStatePanel"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="44"
                                                Height="44"
                                                CornerRadius="16"
                                                Background="#F1E5D3"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="✦"
                                                       Foreground="{StaticResource GoldBrush}"
                                                       FontSize="21"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="RecordsEmptyTitleTextBlock"
                                                   Text="还没有记账记录"
                                                   Margin="0,10,0,0"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RecordsEmptyHintTextBlock"
                                                   Text="从右上角记下一笔，让生活轨迹慢慢长出来"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                    </Grid>
                    </Grid>
                </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
