<Window x:Class="Record.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#EEDDCB"
        Loaded="MainWindow_Loaded"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <!-- 导航图标 -->
        <Geometry x:Key="HomeIcon">
            M12,3 L21,10 V21 H15 V15 H9 V21 H3 V10 Z
        </Geometry>

        <Geometry x:Key="RecordIcon">
            M5,3 H19 V21 H5 Z
            M8,8 H16
            M8,12 H16
            M8,16 H14
        </Geometry>

        <Geometry x:Key="ImportIcon">
            M12,4 V16
            M7,11 L12,16 L17,11
            M5,19 H19 V22 H5 Z
        </Geometry>

        <Geometry x:Key="AnalyticsIcon">
            M4,20 V13 H8 V20 Z
            M10,20 V8 H14 V20 Z
            M16,20 V4 H20 V20 Z
        </Geometry>

        <!-- 全局颜色 -->
        <SolidColorBrush x:Key="PageBrush" Color="#EEDDCB"/>
        <SolidColorBrush x:Key="PaperBrush" Color="#FFF8EE"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFDF8"/>
        <SolidColorBrush x:Key="PlumBrush" Color="#2E2431"/>
        <SolidColorBrush x:Key="InkBrush" Color="#493A35"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#907B70"/>
        <SolidColorBrush x:Key="CoralBrush" Color="#E7775E"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#789B77"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#E4AD4F"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E4CEB0"/>

        <!-- 左侧导航按钮 -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF8EE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Width="56"
                                Height="56"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#5A4355"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#765267"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 当前选中的导航按钮 -->
        <Style x:Key="ActiveNavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
        </Style>

        <!-- 右上角主要按钮 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
            <Setter Property="Padding" Value="17,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBackground"
                                        Property="Background"
                                        Value="#C95E49"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 轻量文字按钮，避免使用系统默认蓝色焦点框 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CoralBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="3,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkBorder" Property="Background" Value="#FFF0E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 账单搜索框：使用主题边框和焦点色，避免系统默认蓝色高亮 -->
        <Style x:Key="RecordSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#FFFBF4"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="32,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 明细表格：GridView 使用同一组列定义，保证表头和每一行严格对齐 -->
        <Style x:Key="RecordsGridViewHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordsTableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#FFF0E8"/>
                                <Setter Property="Foreground" Value="{StaticResource CoralBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#F8D5C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordsListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="RecordsListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,15,0,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FFF9F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 明细筛选按钮 -->
        <Style x:Key="FilterChipStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FilterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#FFF0E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveFilterChipStyle"
               TargetType="Button"
               BasedOn="{StaticResource FilterChipStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CoralBrush}"/>
        </Style>

        <!-- 明细页类别筛选：沿用纸张下拉风格，避免系统默认蓝色高亮 -->
        <Style x:Key="FilterComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF0E8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8E2D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Grid>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                <TextBlock Text="⌄"
                                                           Margin="0,0,10,2"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="15"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFF0E8"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource CoralBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFF0E8"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource CoralBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="DropDownPopup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   VerticalOffset="5"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="135"
                                        Background="{StaticResource PaperBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="5"
                                        Effect="{StaticResource CardShadow}">
                                    <ScrollViewer MaxHeight="230"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="16"
                          ShadowDepth="3"
                          Opacity="0.14"
                          Color="#6A4A3E"/>

    </Window.Resources>

    <Grid Margin="18">

        <!-- 应用外框 -->
        <Border Background="{StaticResource PaperBrush}"
                CornerRadius="24"
                BorderBrush="#C8AA86"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}">

            <Grid>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- 页面纸张纹理 -->
                <Image Source="/Record.Desktop;component/Assets/UI/paper-texture.png"
                    Stretch="UniformToFill"
                    Opacity="0.16"
                    IsHitTestVisible="False"/>

                <!-- 左侧深色图标导航栏 -->
                <Border Grid.Column="0"
                        Background="{StaticResource PlumBrush}"
                        CornerRadius="24,0,0,24">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="88"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 简洁 Logo -->
                        <Border Grid.Row="0"
                                Width="52"
                                Height="52"
                                CornerRadius="18"
                                Background="#514052"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <TextBlock Text="R"
                                       Foreground="#FFF8EE"
                                       FontFamily="Georgia"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 四个必要页面 -->
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Button x:Name="HomeNavButton"
                                    Style="{StaticResource ActiveNavButtonStyle}"
                                    ToolTip="首页"
                                    AutomationProperties.Name="首页"
                                    Click="HomeNavButton_Click">
                                <Path Data="{StaticResource HomeIcon}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                     Path=Foreground}"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="RecordsNavButton"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="记账"
                                    AutomationProperties.Name="记账"
                                    Click="RecordsNavButton_Click">
                                <Path Data="{StaticResource RecordIcon}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                      Path=Foreground}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="ImportNavButton"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="导入"
                                    AutomationProperties.Name="导入"
                                    Click="ImportNavButton_Click">
                                <Path Data="{StaticResource ImportIcon}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                      Path=Foreground}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="AnalyticsNavButton"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="分析"
                                    AutomationProperties.Name="分析"
                                    Click="AnalyticsNavButton_Click">
                                <Path Data="{StaticResource AnalyticsIcon}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                      Path=Foreground}"
                                      Width="25"
                                      Height="25"
                                      Stretch="Uniform"/>
                            </Button>

                        </StackPanel>

                    </Grid>
                </Border>

                <!-- 右侧主内容区域 -->
                <Grid Grid.Column="1">
                <ScrollViewer x:Name="HomePage"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid Margin="34,28,34,34">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 页面标题 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="首页"
                                           Foreground="{StaticResource InkBrush}"
                                           FontFamily="Georgia"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                                <TextBlock Text="把日子里的每一笔，都好好记下来"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="＋ 记一笔"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="AddRecordButton_Click"/>
                        </Grid>

                        <!-- 四个统计卡片 -->
                        <Grid Grid.Row="1"
                              Margin="0,28,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 总支出 -->
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,10,10"
                                    Padding="20"
                                    Background="#FFF0E8"
                                    BorderBrush="#EDB09C"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Effect="{StaticResource CardShadow}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="总支出"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"/>

                                        <TextBlock x:Name="TotalExpenseTextBlock"
                                                   Text="¥ 0.00"
                                                   Margin="0,9,0,0"
                                                   Foreground="{StaticResource CoralBrush}"
                                                   FontSize="25"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="全部已记录支出"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="￥"
                                               Foreground="{StaticResource CoralBrush}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 总收入 -->
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,10"
                                    Padding="20"
                                    Background="#F1F4E9"
                                    BorderBrush="#B8C78D"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Effect="{StaticResource CardShadow}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="总收入"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontSize="14"/>

                                        <TextBlock x:Name="TotalIncomeTextBlock"
                                                   Text="¥ 0.00"
                                                   Margin="0,9,0,0"
                                                   Foreground="{StaticResource GreenBrush}"
                                                   FontSize="25"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="全部已记录收入"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="＋"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 本月支出 -->
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,10,10,0"
                                    Padding="20"
                                    Background="#FFF8EE"
                                    BorderBrush="#E4CEB0"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="本月支出"
